{
  "name": "serveur-imprimantes",
  "version": "1.0.0",
  "private": true,
  "description": "Backend en ligne : API Express pour le site + serveur WebSocket sécurisé (mTLS) pour l'agent local",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "pki": "node scripts/pki.js",
    "agent:enroler": "node --disable-warning=ExperimentalWarning scripts/enroler-agent.js",
    "admin:creer": "node --disable-warning=ExperimentalWarning scripts/creer-admin.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 --test-timeout=60000 test/serveur.test.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "busboy": "^1.6.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "node-forge": "^1.4.3",
    "ws": "^8.23.0"
  }
}
